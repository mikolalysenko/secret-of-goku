{
  "name": "secret-of-goku",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Secret of Mana. With Goku. A vibe coded fan game, not intended for commercial purposes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "audit:seed": "node tools/qa/area-seed.mjs",
    "audit:story": "node tools/qa/story-review.mjs",
    "scenes": "node tools/scenes/cli.mjs",
    "test:scenes": "node tools/scenes/cli.mjs test",
    "audit:ui": "node tools/qa/ui-audit.mjs --state .local/graphics-audit/party.json",
    "audit:menus": "node tools/qa/event-ui-audit.mjs",
    "audit:effects": "node tools/qa/effects-audit.mjs --state .local/graphics-audit/party.json",
    "audit:combat": "node tools/qa/combat-audit.mjs",
    "audit:poses": "node tools/qa/pose-audit.mjs",
    "audit:status": "node tools/qa/status-audit.mjs",
    "audit:areas": "node tools/qa/area-sweep.mjs",
    "audit:barriers": "node tools/qa/barrier-catalog.mjs --out .local/barrier-audit",
    "audit:barrier-runtime": "node tools/qa/barrier-runtime.mjs --out .local/barrier-audit",
    "audit:barrier-destruction": "node tools/qa/barrier-destruction.mjs --out .local/barrier-audit",
    "audit:boss-barriers": "node tools/qa/boss-barriers.mjs --out .local/barrier-audit",
    "audit:dungeon-geometry": "node tools/qa/dungeon-geometry-audit.mjs --out .local/dungeon-audit",
    "audit:dungeons": "node tools/qa/dungeon-runtime-audit.mjs --out .local/dungeon-audit",
    "audit:boss": "node tools/qa/area-manabeast.mjs",
    "audit:report": "node tools/qa/area-report.mjs --screenshots",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "rom:import": "node scripts/import-rom.mjs",
    "rom:inspect": "node tools/rom/cli.mjs inspect .local/rom/secret-of-mana-us.sfc",
    "rom:extract": "node tools/rom/cli.mjs extract .local/rom/secret-of-mana-us.sfc --out assets/data/potos-rom.json --render-dir assets/maps",
    "release": "node scripts/release.mjs",
    "desktop:prepare": "node scripts/release.mjs --stage-only",
    "desktop:start": "node scripts/start-desktop.mjs",
    "test:desktop": "node tests/desktop/smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "pngjs": "^7.0.0"
  }
}
